{
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#268bd2",
          "template": "{{ .Path }}",
          "options": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#b58900",
          "template": " [{{ .Ref }}]"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#859900",
          "template": " > "
        }
      ]
    }
  ]
}
